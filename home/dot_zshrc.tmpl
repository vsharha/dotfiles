{{- $brewPrefix := includeTemplate "brew-prefix" . -}}
# === p10k instant prompt — keep at the VERY TOP, above everything ===
# Keys typed before zsh starts are echoed by the tty at column 0; wipe them so
# the instant prompt draws on this line instead of below a stray fragment.
[[ -t 1 ]] && print -n '\r\e[K'
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# === per-OS locations (rendered by chezmoi) =======================
{{ if eq .chezmoi.os "darwin" -}}
_plugin_dir={{ printf "%s/share" $brewPrefix | quote }}
_p10k_theme=$_plugin_dir/powerlevel10k/powerlevel10k.zsh-theme
export PNPM_HOME="$HOME/Library/pnpm"
{{ else if or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") -}}
# Debian/Ubuntu don't package p10k or fzf-tab and scatter the apt plugins across
# per-package dirs, so the bootstrap stages every plugin under one tree.
_plugin_dir="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"
_p10k_theme=$_plugin_dir/powerlevel10k/powerlevel10k.zsh-theme
{{ if .dev -}}
export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
{{ end -}}
{{ else -}}
_plugin_dir=/usr/share/zsh/plugins
_p10k_theme=/usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
export PNPM_HOME="$HOME/.local/share/pnpm"
{{ end -}}

# === completions (must come before compinit) ===
# ~/.zfunc must precede the system dirs so its overrides (e.g. _pnpm) win.
{{ if eq .chezmoi.os "darwin" -}}
fpath=(~/.zfunc {{ printf "%s/share/zsh-completions" $brewPrefix | quote }} $fpath)
{{ else -}}
fpath=(~/.zfunc $fpath)  # zsh-completions installs into site-functions, already in fpath
{{ end -}}
autoload -Uz compinit && compinit

# === powerlevel10k theme ===
source "$_p10k_theme"

# === PATH / environment ===========================================
typeset -U path
{{ if .dev -}}
path=("$PNPM_HOME" "$HOME/.local/bin" "$HOME/go/bin" $path)
{{ else -}}
path=("$HOME/.local/bin" $path)
{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
path=(
  {{ printf "%s/opt/openjdk/bin" $brewPrefix | quote }}
  "$HOME/.antigravity/antigravity/bin"
  "$HOME/.local/share/solana/install/active_release/bin"
  "$HOME/.lmstudio/bin"
  $path
)
{{ end -}}
{{ if not .headless -}}
export EDITOR="code --wait"
{{ end }}
# === history ======================================================
# Explicit config so every OS behaves the same — macOS caps SAVEHIST at
# 1000 in /etc/zshrc and Linux distros vary. Large limits keep fzf Ctrl-R
# and the history-based autosuggestions useful long-term.
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt inc_append_history     # write each command as it runs, not on exit
setopt hist_ignore_all_dups   # drop older duplicates so Ctrl-R shows unique lines
setopt hist_ignore_space      # leading space keeps a command out of history
setopt hist_reduce_blanks     # normalise whitespace before saving
setopt extended_history       # save a start timestamp with each entry
setopt hist_fcntl_lock        # lock with fcntl() so concurrent tabs don't corrupt the file
setopt hist_verify            # show !!, !$ etc. expanded for review before running

# === aliases ======================================================
alias python=python3
{{ if .dev -}}
alias shadcn='pnpm dlx shadcn@latest'
alias shadcn-sv='pnpm dlx shadcn-svelte@latest'
{{ end -}}
{{/* Both axes: skipping the permission prompts suits a machine someone is
sitting at, where each action is watched as it happens. A headless dev box is
unattended and holds credentials and push access, so it keeps the prompts. */ -}}
{{ if and .dev (not .headless) -}}
alias cc="claude --dangerously-skip-permissions"
{{ end -}}

# === fzf (fuzzy Ctrl-R history, Ctrl-T files, Alt-C cd) ===========
# `fzf --zsh` exists only on fzf >= 0.48 (macOS/Arch ship current builds);
# Debian's older package installs the scripts under /usr/share/doc/fzf instead.
if fzf --zsh >/dev/null 2>&1; then
  source <(fzf --zsh)
elif [[ -d /usr/share/doc/fzf/examples ]]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
  source /usr/share/doc/fzf/examples/completion.zsh
fi

# === fzf-tab (replaces the completion menu with an fzf picker) =====
# Must load after compinit/fzf and BEFORE autosuggestions & syntax-highlighting.
zstyle ':completion:*' menu no                     # let fzf-tab own the menu
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':fzf-tab:*' switch-group '<' '>'           # < / > to switch groups
source "$_plugin_dir/fzf-tab/fzf-tab.zsh"

# === autosuggestions (grey history hints, → to accept) ============
# completion before history so path args (cd) are validated against the real
# cwd; raw history alone suggests stale paths that don't exist from here.
ZSH_AUTOSUGGEST_STRATEGY=(completion history)
source "$_plugin_dir/zsh-autosuggestions/zsh-autosuggestions.zsh"

# The completion strategy's hook forces compstate[insert]=1, making the grey
# hint the first full candidate. `unambiguous` makes it the longest common
# prefix, the same text fzf-tab inserts on the first Tab, so accepting the hint
# and pressing Tab agree. History hits still show the full recalled line.
#
# This replaces a private plugin function, so it applies only while upstream
# still sets compstate[insert]=1, and warns otherwise.
if [[ "$(functions _zsh_autosuggest_capture_postcompletion 2>/dev/null)" == *'compstate[insert]=1'* ]]; then
  _zsh_autosuggest_capture_postcompletion() {
    compstate[insert]=unambiguous
    unset 'compstate[list]'
  }
else
  print -u2 "zshrc: zsh-autosuggestions capture hook changed upstream; recheck common-prefix grey-hint patch"
fi

# === history substring search (↑/↓ filters by substring) ==========
# Keep successful and failed searches uncoloured — highlighted trailing spaces
# render as ugly solid colour blocks.
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND=''
HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND=''
source "$_plugin_dir/zsh-history-substring-search/zsh-history-substring-search.zsh"
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

{{ if eq .chezmoi.os "linux" -}}
# === line navigation ==============================================
# zsh's emacs keymap doesn't bind these; both CSI variants covered.
# macOS doesn't need this — Cmd/Option arrows are handled by the terminal.
bindkey '^[[H'    beginning-of-line        # Home
bindkey '^[[1~'   beginning-of-line
bindkey '^[OH'    beginning-of-line
bindkey '^[[F'    end-of-line              # End
bindkey '^[[4~'   end-of-line
bindkey '^[OF'    end-of-line
bindkey '^[[1;5D' backward-word            # Ctrl-Left
bindkey '^[[1;5C' forward-word             # Ctrl-Right
bindkey '^[[1;3D' backward-word            # Alt-Left
bindkey '^[[1;3C' forward-word             # Alt-Right
bindkey '^[[1;5H' beginning-of-buffer-or-history   # Ctrl-Home
bindkey '^[[1;5F' end-of-buffer-or-history         # Ctrl-End
bindkey '^[[3~'   delete-char              # Delete
bindkey '^H'      backward-kill-word       # Ctrl-Backspace
bindkey '^[[3;5~' kill-word                # Ctrl-Delete

# GUI-style word boundaries: jumps and word-deletes stop at / . - _ instead
# of swallowing whole paths (affects Ctrl/Alt+arrows, Ctrl+Backspace/Delete).
autoload -U select-word-style
select-word-style bash

{{ end -}}

# zsh defaults ^U to kill-whole-line; standard bash uses it to clear
# to the beginning of the line. We match bash so Cmd+Backspace (which
# Ghostty maps to ^U on macOS) clears only behind the cursor.
bindkey '^U' backward-kill-line

# === Shift+arrows selection (GUI-editor style) ====================
# Vendored plugin (not packaged for Arch or Homebrew). Shift+Home/End and
# Shift+Ctrl (Linux) / Shift+Option (macOS) +arrows select by word; typing
# or Backspace replaces/deletes the selection.
source ~/.config/zsh/zsh-shift-select.zsh

# Copying the keyboard selection is on Cmd+Shift+C (macOS) / Ctrl+Shift+C
# (Linux), which ghostty sends as a CSI-u sequence. Ctrl-C stays an interrupt:
# it arrives as SIGINT, and p10k resets the INT trap on every prompt.
{{- $copyCommand := "" -}}
{{- $copyKey := "" -}}
{{- if and (eq .chezmoi.os "darwin") (not .headless) -}}
{{-   $copyCommand = "pbcopy" -}}
{{-   $copyKey = "^[[99;9u" -}}
{{- else if and (eq .chezmoi.os "linux") (not .headless) -}}
{{-   $copyCommand = "wl-copy" -}}
{{-   $copyKey = "^[[99;6u" -}}
{{- end }}
{{ if $copyCommand -}}
# Only the CachyOS package list installs wl-clipboard, so bind the key just
# where the clipboard command exists rather than leaving a key that silently
# does nothing.
if command -v {{ $copyCommand }} >/dev/null 2>&1; then
  copy-selection() {
    (( REGION_ACTIVE )) || return 0
    local _from=$(( (MARK < CURSOR ? MARK : CURSOR) + 1 ))
    local _to=$(( MARK > CURSOR ? MARK : CURSOR ))
    print -rn -- "${BUFFER[_from,_to]}" | {{ $copyCommand }} 2>/dev/null
  }
  zle -N copy-selection
  bindkey '{{ $copyKey }}' copy-selection
  bindkey -M shift-select '{{ $copyKey }}' copy-selection
fi
{{ end -}}

# === Tab / Shift-Tab behaviour ====================================
# zsh-autosuggestions wraps every widget to blank $POSTDISPLAY before it runs, so
# smart-tab could never see the suggestion; IGNORE_WIDGETS leaves it unwrapped.
typeset -ga ZSH_AUTOSUGGEST_IGNORE_WIDGETS
ZSH_AUTOSUGGEST_IGNORE_WIDGETS+=(smart-tab)

fzf-tab-complete-with-local-cwd() {
  local _cwd_before=$PWD
  local -a _saved_chpwd_functions=("${chpwd_functions[@]}")
  {
    # SSH completion can cd into ~/.ssh and stay there. Mute ghostty's cwd
    # reporter while completing, then return to the starting directory and
    # report it, so a new tab opens where this shell actually is.
    chpwd_functions=(${chpwd_functions:#_ghostty_report_pwd})
    zle fzf-tab-complete
  } always {
    chpwd_functions=("${_saved_chpwd_functions[@]}")
    builtin cd -q -- "$_cwd_before" 2>/dev/null
    (( $+functions[_ghostty_report_pwd] )) && _ghostty_report_pwd
  }
}

smart-tab() {
  if [[ -n "$POSTDISPLAY" ]]; then
    zle autosuggest-accept
  else
    fzf-tab-complete-with-local-cwd
  fi
}
zle -N smart-tab
bindkey '^I'   smart-tab                          # Tab

# Shift-Tab opens the picker on the first press. With `menu no`, fzf-tab only
# inserts the common prefix on the first press; `menu yes` for this one call
# makes it list immediately.
fzf-tab-list() {
  {
    zstyle ':completion:*' menu yes
    fzf-tab-complete-with-local-cwd
  } always {
    zstyle ':completion:*' menu no
  }
}
zle -N fzf-tab-list
bindkey '^[[Z' fzf-tab-list                       # Shift-Tab

# === empty Enter redraws the prompt in place ======================
# Holding Enter on an empty line would otherwise scroll a column of transient
# prompts. The precmd hooks rebuild p10k's PROMPT, so they run before the
# redraw; reset-prompt alone would show stale segments. Ctrl-J stays plain
# accept-line, for when a new prompt line is wanted.
refresh-or-accept-line() {
  # No leading dot: the real accept-line keeps the autosuggestions and
  # syntax-highlighting wrappers that a typed command needs.
  if [[ -n ${BUFFER//[[:space:]]/} ]]; then
    zle accept-line
    return
  fi
  BUFFER=
  local f
  for f in $precmd_functions; do
    (( $+functions[$f] )) && $f
  done
  zle .reset-prompt
}
zle -N refresh-or-accept-line
bindkey '^M' refresh-or-accept-line               # Enter

# Shift+Enter and Ctrl+Enter arrive as modifyOtherKeys sequences when a
# program leaves that mode on. Unbound, zle drops a prefix of the sequence and
# self-inserts the rest (such as ';13~'), so bind the full sequences to insert
# a newline instead.
insert-newline() { LBUFFER+=$'\n' }
zle -N insert-newline
bindkey '^[[27;2;13~' insert-newline              # Shift-Enter
bindkey '^[[27;5;13~' insert-newline              # Ctrl-Enter

# === syntax highlighting (MUST be last of the plugin sources) =====
source "$_plugin_dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# === zoxide (cd ranked by how often and how recently a dir is used) ==
# `z` jumps to the highest-ranked directory matching its arguments. `zi` picks
# from the matches interactively. Plain `cd` remains the shell builtin so a bad
# path fails instead of taking a fuzzy match from zoxide's database.
# Guarded because the database and the binary are optional — a machine whose
# distro has no zoxide package still gets a working shell, with plain cd.
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

unset _plugin_dir _p10k_theme

# === finished-command notifications ==============================
# Notify after an unattended foreground command returns. Ghostty suppresses
# desktop notifications while its surface is focused, so commands completed
# while this terminal is being watched stay quiet.
autoload -Uz add-zsh-hook
zmodload zsh/datetime

typeset -gF _notify_command_started_at=-1
typeset -g _notify_command_text=''
typeset -g _notify_command_cwd=''

_notify_command_start() {
  _notify_command_started_at=$EPOCHREALTIME
  _notify_command_text=$1
  _notify_command_cwd=$PWD
}

_notify_command_finish() {
  local exit_status=$?
  local -F 1 elapsed
  (( _notify_command_started_at >= 0 )) || return 0

  elapsed=$(( EPOCHREALTIME - _notify_command_started_at ))
  _notify_command_started_at=-1
  (( elapsed >= 20 )) || return 0

  local title=${_notify_command_cwd:t}
  local summary=''
  local body

  # A leading space keeps sensitive commands out of history; keep their text
  # out of desktop notifications too. Control characters and semicolons would
  # otherwise corrupt Ghostty's OSC 777 notification fields.
  if [[ $_notify_command_text != ' '* ]]; then
    summary=${_notify_command_text//[[:cntrl:]]/ }
    summary=${summary//;/,}
    summary=${summary[1,100]}
  fi
  title=${title//[[:cntrl:]]/ }
  title=${title//;/,}
  title=${title[1,60]}

  if (( exit_status == 0 )); then
    body="Finished in ${elapsed}s"
  else
    body="Exited ${exit_status} after ${elapsed}s"
  fi
  [[ -n $summary ]] && body+=" — ${summary}"

  printf '\033]777;notify;%s;%s\033\\' "$title" "$body" 2>/dev/null >/dev/tty || true
  return 0
}

add-zsh-hook preexec _notify_command_start
add-zsh-hook precmd _notify_command_finish

# === p10k prompt config — keep at the very BOTTOM =================
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
