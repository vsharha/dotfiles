# Read by every zsh, including non-interactive ones (zsh -c, scripts, commands
# run over ssh), so only variables those need belong here. PATH stays in
# .zshrc: on macOS, path_helper in /etc/zprofile runs after this file in login
# shells and would move our entries behind the system directories.

# Keeps __pycache__ directories out of project checkouts.
export PYTHONPYCACHEPREFIX="${XDG_CACHE_HOME:-$HOME/.cache}/pycache"

{{ if eq .chezmoi.os "darwin" -}}
# SOPS on macOS would otherwise look under ~/Library/Application Support.
export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"
{{ else -}}
# The homelab origin's provisioning installs sops and a TPM-held age identity
# readable by the tss group. Its units set the variable themselves; this covers
# sops run by hand. No other Linux machine has the file.
if [[ -r /etc/homelab/age-identity.txt ]]; then
  export SOPS_AGE_KEY_FILE=/etc/homelab/age-identity.txt
fi
{{ end -}}
