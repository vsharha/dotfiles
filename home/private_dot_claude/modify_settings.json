#!/bin/sh
# chezmoi owns the fields set below in ~/.claude/settings.json; any other keys
# Claude Code writes at runtime are preserved. Fields are set as leaf paths so
# sibling keys (e.g. a permissions.allow list) survive too.
#
# Requires jq at apply time. Applied wherever the dev role is set, which
# includes headless machines such as containers and cloud sandboxes, so jq
# belongs in the package list of any image that runs apply with dev true.
input=$(cat)
[ -z "$input" ] && input='{}'

printf '%s' "$input" | jq '
    .attribution.commit = ""
  | .attribution.pr = ""
  | .attribution.sessionUrl = false
  | .permissions.defaultMode = "auto"
  | .skipDangerousModePermissionPrompt = true
  | .skipAutoPermissionPrompt = true
  | .tui = "fullscreen"
  | .alwaysThinkingEnabled = true
  | .verbose = true
  | .awaySummaryEnabled = false
  | .workflowKeywordTriggerEnabled = false
  | .switchModelsOnFlag = false
  | .remoteControlAtStartup = false
  | .agentPushNotifEnabled = true
  | .hooks.Stop = [{"hooks": [{"type": "command", "command": "\"$HOME/.claude/notify-turn-end.sh\""}]}]
  | .hooks.StopFailure = [{"hooks": [{"type": "command", "command": "\"$HOME/.claude/notify-turn-end.sh\""}]}]
'
