{{/* apply.sh sets DOTFILES_<AXIS> for each axis a flag names, and that value
replaces the saved answer. An axis no flag names keeps its saved answer, and is
asked for only on a machine that has never answered it. */ -}}
{{- $headless := false -}}
{{- if env "DOTFILES_HEADLESS" -}}
{{-   $headless = eq (env "DOTFILES_HEADLESS") "true" -}}
{{- else -}}
{{-   $headless = promptBoolOnce . "headless" "Headless server (no desktop)" false -}}
{{- end -}}
{{- $dev := false -}}
{{- if env "DOTFILES_DEV" -}}
{{-   $dev = eq (env "DOTFILES_DEV") "true" -}}
{{- else -}}
{{-   $dev = promptBoolOnce . "dev" "Development and agent configuration" (not $headless) -}}
{{- end -}}
{{- $personal := false -}}
{{- if env "DOTFILES_PERSONAL" -}}
{{-   $personal = eq (env "DOTFILES_PERSONAL") "true" -}}
{{- else -}}
{{-   $personal = promptBoolOnce . "personal" "Personal accounts and services" true -}}
{{- end -}}
{{- $email := env "DOTFILES_EMAIL" -}}
{{- if not $email -}}
{{-   $email = promptStringOnce . "email" "Git email" "vsharha07@gmail.com" -}}
{{- end -}}
[data]
    headless = {{ $headless }}
    dev = {{ $dev }}
    personal = {{ $personal }}
    email = {{ $email | quote }}
